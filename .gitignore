# 构建产物
build/
dist/
out/
bin/
obj/

# 依赖
node_modules/
vendor/
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# 临时与日志
temp/
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# 本地配置与凭据：含明文账号密码，严禁入库（仓库里只保留 config.sample.json）
config.json

# 自研训练模型：作者私有资产，不入开源仓库。
# 权重本身与训练数据都不公开，仓库里只留 models/README.md 说明来源与替换方式。
# 缺少该模型时构建照常成功，程序启动后 crnn 后端不可用，登录验证码自动退回手输。
models/*.onnx

# 编辑器与 IDE
.vs/
.idea/
.vscode/
*.user
*.suo

# 大体积产物（>500 MB 不入库，放本机临时输出目录）
*.iso
*.vmdk
*.pdb
